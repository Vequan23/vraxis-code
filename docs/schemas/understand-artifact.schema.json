{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vraxis.dev/schemas/understand-artifact.schema.json",
  "title": "Vraxis Code signed understanding artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "version", "generatedAt", "deepLink", "sourceProof", "session", "project",
    "verdict", "changes", "claims", "risks", "teachBack", "evidenceLinks", "artifactId", "integrity"
  ],
  "properties": {
    "kind": { "const": "vraxis.understand-artifact" },
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "deepLink": { "type": "string", "pattern": "^vraxis-code://task/", "maxLength": 4096 },
    "sourceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "keyId"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/artifactId" },
        "keyId": { "$ref": "#/$defs/digest" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "mode", "runtimeId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/label" },
        "mode": { "enum": ["ask", "plan", "build", "review"] },
        "runtimeId": { "$ref": "#/$defs/id" },
        "modelId": { "$ref": "#/$defs/id" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "branch"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/label" },
        "branch": { "$ref": "#/$defs/label" }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "summary"],
      "properties": {
        "state": { "enum": ["verified", "partially-verified", "unverified", "needs-review"] },
        "summary": { "$ref": "#/$defs/text" }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "status", "coverage", "verificationIds"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "status": { "enum": ["added", "modified", "deleted", "renamed", "untracked"] },
          "previousPath": { "$ref": "#/$defs/path" },
          "coverage": { "enum": ["verified", "unverified"] },
          "verificationIds": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/claim" }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "title", "detail", "evidenceIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "severity": { "enum": ["info", "warning", "critical"] },
          "title": { "$ref": "#/$defs/label" },
          "detail": { "$ref": "#/$defs/text" },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "branch", "baseBranch", "baseCommit", "evidenceIds"],
      "properties": {
        "summary": { "$ref": "#/$defs/text" },
        "branch": { "$ref": "#/$defs/label" },
        "baseBranch": { "$ref": "#/$defs/label" },
        "baseCommit": { "$ref": "#/$defs/gitCommit" },
        "checkpointCommit": { "$ref": "#/$defs/gitCommit" },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "teachBack": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "evidenceIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "question": { "$ref": "#/$defs/text" },
          "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
        }
      }
    },
    "evidenceLinks": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "target", "label", "deepLink"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["change", "terminal", "approval", "browser", "verification", "worktree"] },
          "target": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "label": { "$ref": "#/$defs/label" },
          "deepLink": { "type": "string", "pattern": "^vraxis-code://task/", "maxLength": 8192 }
        }
      }
    },
    "artifactId": { "$ref": "#/$defs/artifactId" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "label": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "text": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "evidenceIds": {
      "type": "array",
      "maxItems": 50000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "digestAlgorithm", "digest", "signature", "publicKey", "publicKeyFormat", "keyId"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "canonicalization": { "const": "vraxis-json-c14n-v1" },
        "digestAlgorithm": { "const": "SHA-256" },
        "digest": { "$ref": "#/$defs/digest" },
        "signature": { "type": "string", "minLength": 1, "maxLength": 1024, "contentEncoding": "base64" },
        "publicKey": { "type": "string", "minLength": 1, "maxLength": 4096, "contentEncoding": "base64" },
        "publicKeyFormat": { "const": "spki-base64" },
        "keyId": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
