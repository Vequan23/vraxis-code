{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vraxis.dev/schemas/verify.schema.json",
  "title": "Vraxis Code verification recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "checks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 64 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "category": { "enum": ["lint", "typecheck", "test", "build", "check"] },
          "command": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$" },
          "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
          "cwd": { "type": "string", "minLength": 1, "maxLength": 512 },
          "required": { "type": "boolean" },
          "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 1800000 }
        }
      }
    },
    "services": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "health"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 64 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "command": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S+$" },
          "args": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
          "cwd": { "type": "string", "minLength": 1, "maxLength": 512 },
          "health": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri", "maxLength": 2048 },
              "expectedStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
              "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
              "intervalMs": { "type": "integer", "minimum": 100, "maximum": 5000 }
            }
          }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "url": { "type": "string", "format": "uri", "maxLength": 2048 },
        "assertions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "value"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 64 },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "kind": { "enum": ["url", "title", "text"] },
              "match": { "enum": ["equals", "contains"] },
              "value": { "type": "string", "minLength": 1, "maxLength": 512 },
              "caseSensitive": { "type": "boolean" }
            }
          }
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline"],
          "properties": {
            "baseline": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\.png$" },
            "maxDiffRatio": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
