{
  "name": "@vraxis/code-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:windows": "node --import tsx --test --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "@vraxis/agent-v": "^0.12.0",
    "@vraxis/code-contracts": "0.1.0",
    "node-pty": "^1.1.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@vraxis/code-test-runtime": "0.1.0",
    "tsx": "^4.23.0"
  }
}
